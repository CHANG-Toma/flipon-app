{
  "name": "flipon-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android.ps1",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-setup.ps1",
    "android:devices": "powershell -NoProfile -ExecutionPolicy Bypass -Command \". ./scripts/android-env.ps1; adb devices; emulator -list-avds\"",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:tunnel": "expo start --tunnel",
    "lint": "expo lint",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "eas:init": "npx eas-cli@latest init",
    "build:ios-sim": "npx eas-cli@latest build --platform ios --profile ios-simulator",
    "build:android-dev": "npx eas-cli@latest build --platform android --profile development",
    "build:preview": "npx eas-cli@latest build --platform all --profile preview",
    "build:run:ios": "npx eas-cli@latest build:run -p ios --latest"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
