# Copy this file to .env and fill real values locally.
# Never commit .env

# Site FlipOn (QR / liens d’invitation → navigateur si pas d’app)
EXPO_PUBLIC_WEB_URL=https://flipon.vercel.app

# API (par défaut = même base que le site)
# EXPO_PUBLIC_API_URL=https://flipon.vercel.app

# Clerk — Google Sign-In (dashboard.clerk.com)
# Active le provider Google, ajoute le redirect : fliponapp://oauth-native-callback
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Example (replace later when backend is ready)
# REVENUECAT_API_KEY=
